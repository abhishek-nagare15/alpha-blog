<div class="container" id="home-container">

  <div id="home-hero"
       class="text-center text-white rounded shadow">

    <h1 class="display-4">
      Alpha Blog
    </h1>

    <p class="lead">
      This is a simple blog application where you can create,
      view, edit, and manage articles.

<div class="container mt-4">
  <h1 class="text-center mb-4">Showing Article Details</h1>

  <div class="card shadow-sm">
    <div class="card-body">

      <p class="text-muted">
        Created by: <strong><%= @article.user.username %></strong>
      </p>

      <h3 class="card-title">
        <%= @article.title %>
      </h3>

      <p class="card-text">
        <%= @article.description %>
      </p>

      <hr>

      <%= link_to "Edit",
                  edit_article_path(@article),
                  class: "btn btn-warning" %>

      <%= link_to "Delete",
                  article_path(@article),
                  class: "btn btn-danger",
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure?"
                  } %>

      <%= link_to "Return to articles",
                  articles_path,
                  class: "btn btn-secondary" %>
    </div>
  </div>
</div>
<%= form_with(model: @article, local: true, data: { turbo: false }) do |f| %>

  <%= render 'shared/errors', obj: @article %>

  <div class="form-group row">
    <%= f.label :title, class: "col-2 col-form-label" %>

    <div class="col-10">
      <%= f.text_field :title,
                       class: "form-control shadow rounded",
                       placeholder: "Title of article" %>
    </div>
  </div>

  <div class="form-group row">
    <%= f.label :description, class: "col-2 col-form-label" %>

    <div class="col-10">
      <%= f.text_area :description,
                      rows: 10,
                      class: "form-control shadow rounded",
                      placeholder: "Description of article" %>
    </div>
  </div>

  <div class="form-group row">
    <%= f.label :category_ids, "Categories", class: "col-2 col-form-label" %>

    <div class="col-10">
      <%= f.collection_select(
            :category_ids,
            Category.all,
            :id,
            :name,
            { prompt: "Select categories" },
            {
              multiple: true,
              size: 4,
              class: "form-control shadow rounded category-select"
            }
          ) %>

      <small class="form-text text-muted">
        Hold Ctrl (Windows/Linux) or Command (Mac) to select multiple categories.
      </small>
    </div>
  </div>

  <div class="form-group row justify-content-center">
    <%= f.submit class: "btn btn-primary btn-lg shadow-sm" %>
  </div>

<% end %>
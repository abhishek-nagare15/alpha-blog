<section class="listing-page">
  <div class="container">

    <div class="page-heading text-center mb-5">
      <span class="section-kicker">CATEGORY</span>

      <h1><%= @category.name %></h1>

      <p>
        Articles in the <%= @category.name %> category.
      </p>
    </div>

    <div class="text-center mb-5">
      <%= link_to "Back to Categories",
                  categories_path,
                  class: "btn btn-outline-primary" %>

      <% if logged_in? && current_user.admin? %>
        <%= link_to "Edit Category",
                    edit_category_path(@category),
                    class: "btn btn-primary ms-2" %>
      <% end %>
    </div>

    <% if @articles.any? %>
      <div class="pagination-wrapper">
        <%= will_paginate @articles %>
      </div>

      <div class="articles-list">
        <%= render partial: "articles/article",
                   locals: { articles: @articles } %>
      </div>

      <div class="pagination-wrapper">
        <%= will_paginate @articles %>
      </div>
    <% else %>
      <div class="text-center py-5">
        <p>No articles have been added to this category yet.</p>
      </div>
    <% end %>

  </div>
</section>
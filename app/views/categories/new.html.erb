<section class="listing-page">
  <div class="container">
    <div class="page-heading text-center mb-5">
      <span class="section-kicker">CATEGORIES</span>
      <h1>Create a New Category</h1>
      <p>Add a category to organize your articles.</p>
    </div>

    <div class="row justify-content-center">
      <div class="col-12 col-md-8 col-lg-6">
        <%= render "shared/errors", obj: @category %>

        <div class="article-show-card">
          <%= form_with model: @category, local: true do |f| %>
            <div class="mb-4">
              <%= f.label :name, "Category Name", class: "form-label fw-semibold" %>

              <%= f.text_field :name,
                  class: "form-control",
                  placeholder: "Enter category name",
                  autocomplete: "off" %>
            </div>

            <div class="d-flex flex-wrap gap-2">
              <%= f.submit "Create Category",
                  class: "btn btn-primary" %>

              <%= link_to "Cancel",
                  articles_path,
                  class: "btn btn-outline-secondary" %>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</section>